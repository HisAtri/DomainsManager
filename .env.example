DOMAINSMANAGER_DATABASE_TYPE=sqlite
DOMAINSMANAGER_DATABASE_PATH=domainsmanager.db
DOMAINSMANAGER_DATABASE_POOL_SIZE=5
DOMAINSMANAGER_DATABASE_MAX_OVERFLOW=10
DOMAINSMANAGER_DATABASE_POOL_TIMEOUT=30
DOMAINSMANAGER_DATABASE_POOL_RECYCLE=1800
DOMAINSMANAGER_DATABASE_CONNECT_TIMEOUT=10
DOMAINSMANAGER_DATABASE_COMMAND_TIMEOUT=30
DOMAINSMANAGER_SERVER_HOST=127.0.0.1
DOMAINSMANAGER_SERVER_PORT=7920
DOMAINSMANAGER_REGISTRATION_ENABLED=false
DOMAINSMANAGER_JWT_SECRET_KEY=replace-me
DOMAINSMANAGER_REFRESH_TOKEN_PEPPER=replace-me
# Set to true when the application is served through HTTPS.
DOMAINSMANAGER_REFRESH_COOKIE_SECURE=false
DOMAINSMANAGER_REFRESH_COOKIE_SAMESITE=lax
DOMAINSMANAGER_TASK_LEASE_SECONDS=120
DOMAINSMANAGER_TASK_MAX_ATTEMPTS=5
DOMAINSMANAGER_TASK_RETRY_BASE_SECONDS=60
DOMAINSMANAGER_TASK_RETRY_MAX_SECONDS=3600
DOMAINSMANAGER_CHECK_INTERVAL_SECONDS=86400
DOMAINSMANAGER_SUCCESSFUL_REFRESH_TTL_SECONDS=1800
DOMAINSMANAGER_WORKER_POLL_INTERVAL_SECONDS=1
DOMAINSMANAGER_SCHEDULER_POLL_INTERVAL_SECONDS=10
DOMAINSMANAGER_SCHEDULER_BATCH_SIZE=100
DOMAINSMANAGER_NOTIFICATION_WORKER_POLL_INTERVAL_SECONDS=1
DOMAINSMANAGER_NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=10
DOMAINSMANAGER_NOTIFICATION_MAX_ATTEMPTS=5
DOMAINSMANAGER_NOTIFICATION_RETRY_BASE_SECONDS=60
DOMAINSMANAGER_NOTIFICATION_RETRY_MAX_SECONDS=3600
# DOMAINSMANAGER_SMTP_HOST=smtp.example.com
# DOMAINSMANAGER_SMTP_FROM=domains@example.com
# DOMAINSMANAGER_BOOTSTRAP_ADMIN_USERNAME=admin
# DOMAINSMANAGER_BOOTSTRAP_ADMIN_PASSWORD=change-me
DOMAINSMANAGER_DOCS_ENABLED=true
