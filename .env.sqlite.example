DOMAINSMANAGER_DATABASE_TYPE=sqlite
DOMAINSMANAGER_DATABASE_PATH=domainsmanager.db
DOMAINSMANAGER_SERVER_HOST=127.0.0.1
DOMAINSMANAGER_SERVER_PORT=7920
DOMAINSMANAGER_REGISTRATION_ENABLED=false
DOMAINSMANAGER_JWT_SECRET_KEY=replace-me
DOMAINSMANAGER_REFRESH_TOKEN_PEPPER=replace-me
DOMAINSMANAGER_TASK_LEASE_SECONDS=120
DOMAINSMANAGER_TASK_MAX_ATTEMPTS=5
DOMAINSMANAGER_TASK_RETRY_BASE_SECONDS=60
DOMAINSMANAGER_TASK_RETRY_MAX_SECONDS=3600
DOMAINSMANAGER_CHECK_INTERVAL_SECONDS=86400
DOMAINSMANAGER_WORKER_POLL_INTERVAL_SECONDS=1
# DOMAINSMANAGER_BOOTSTRAP_ADMIN_USERNAME=admin
# DOMAINSMANAGER_BOOTSTRAP_ADMIN_PASSWORD=change-me
DOMAINSMANAGER_DOCS_ENABLED=true
